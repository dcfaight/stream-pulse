# Postgres
DATABASE_URL=postgresql://streampulse:streampulse@localhost:5432/streampulse

# Redis
REDIS_URL=redis://localhost:6379

# LLM (required for agentic features; omit or leave blank for rule-based fallback)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Ingestor
INGESTOR_PORT=4001
INGESTOR_HTTP_PATH=/telemetry

# QoE Engine
QOE_ENGINE_PORT=4002
QOE_SEGMENT_WINDOW_MS=10000

# Agent Orchestrator
AGENT_ORCHESTRATOR_PORT=4003

# Dashboard
NEXT_PUBLIC_INGESTOR_HTTP_URL=http://localhost:4001/telemetry
NEXT_PUBLIC_API_BASE_URL=http://localhost:4003

# Observability (optional — set to true to enable OpenTelemetry instrumentation)
ENABLE_OTEL=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=stream-pulse
