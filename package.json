{
  "name": "stream-pulse",
  "private": true,
  "version": "0.0.1",
  "description": "Agentic livestream quality observability and incident orchestration for WebRTC sessions",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
